<?xml version="1.0" encoding="utf-8"?>
<!-- Adaptive launcher icon (engineering standard §17.5). Layers are made by
     tool/generate_launcher_icons.py from assets/app_icon.png. The monochrome
     layer is used for themed icons on Android 13+ and ignored before. -->
<adaptive-icon xmlns:android="http://schemas.android.com/apk/res/android">
    <background android:drawable="@color/ic_launcher_background" />
    <foreground android:drawable="@mipmap/ic_launcher_foreground" />
    <monochrome android:drawable="@mipmap/ic_launcher_monochrome" />
</adaptive-icon>
