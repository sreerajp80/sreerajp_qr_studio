  "helpPermissionsIntro": "Permissions let an app use parts of your phone, such as the camera. This app asks only for what a feature needs, and only when you use that feature. You can see or change them at any time in Android Settings > Apps > this app > Permissions.",
  "@helpPermissionsIntro": {
    "description": "Introduction at the top of the Permissions screen"
  },
  "labelPermGroupAsked": "Asked when needed",
  "@labelPermGroupAsked": {
    "description": "Permissions screen group heading: permissions Android asks the user for"
  },
  "helpPermGroupAskedNote": "Android asks you before the app can use these. If you say no, the rest of the app still works.",
  "@helpPermGroupAskedNote": {
    "description": "Short note under the \"Asked when needed\" group heading"
  },
  "labelPermGroupInstall": "Allowed at install",
  "@labelPermGroupInstall": {
    "description": "Permissions screen group heading: permissions Android allows at install without asking"
  },
  "helpPermGroupInstallNote": "Android allows these when the app is installed, without asking. Each one is used only for the feature named here.",
  "@helpPermGroupInstallNote": {
    "description": "Short note under the \"Allowed at install\" group heading"
  },
  "labelPermGroupNotUsed": "Not asked for",
  "@labelPermGroupNotUsed": {
    "description": "Permissions screen group heading: permissions the app does not ask for"
  },
  "helpPermGroupNotUsedNote": "The app does not ask for these, so it cannot use them.",
  "@helpPermGroupNotUsedNote": {
    "description": "Short note under the \"Not asked for\" group heading"
  },
  "labelPermCamera": "Camera",
  "@labelPermCamera": {
    "description": "Permission name: camera"
  },
  "helpPermCameraDesc": "Used to scan QR codes and barcodes, and for AR CodeVision and receiving AirQR transfers. Android asks you the first time you open a camera screen. Camera pictures are read on your phone and are never saved or sent. If you say no, you can still scan from pictures and PDFs.",
  "@helpPermCameraDesc": {
    "description": "What the camera permission is used for, in plain words"
  },
  "labelPermLocation": "Location",
  "@labelPermLocation": {
    "description": "Permission name: location"
  },
  "helpPermLocationDesc": "Used only when you tap Use My Location in CodeForge, to put your current place into a map QR code. The app reads your position once, does not keep it and never sends it anywhere. It is never used in the background. If you say no, you can type the place yourself.",
  "@helpPermLocationDesc": {
    "description": "What the location permission is used for, in plain words"
  },
  "labelPermBiometric": "Fingerprint or face",
  "@labelPermBiometric": {
    "description": "Permission name: fingerprint or face unlock"
  },
  "helpPermBiometricDesc": "Used by App lock, and to open locked StegoQR items with your fingerprint, face or screen lock. Android does the check and only tells the app whether it passed. The app never sees your fingerprint or face.",
  "@helpPermBiometricDesc": {
    "description": "What the biometric permission is used for, in plain words"
  },
  "labelPermNotifications": "Notifications",
  "@labelPermNotifications": {
    "description": "Permission name: notifications"
  },
  "helpPermNotificationsDesc": "Used only while the Scan bubble is on, to show that it is on, with a Turn off button. Android asks the first time you turn the bubble on. If you say no, the bubble still works, just without the notice.",
  "@helpPermNotificationsDesc": {
    "description": "What the notification permission is used for, in plain words"
  },
  "labelPermOverlay": "Show over other apps",
  "@labelPermOverlay": {
    "description": "Permission name: display over other apps"
  },
  "helpPermOverlayDesc": "Lets the Scan bubble float over other apps, so you can scan a code you see on screen. Used only after you turn the bubble on. The app explains this first, then opens the Android page where you allow it. If you do not allow it, the bubble stays off.",
  "@helpPermOverlayDesc": {
    "description": "What the display-over-other-apps permission is used for, in plain words"
  },
  "labelPermScreenCapture": "Screen capture",
  "@labelPermScreenCapture": {
    "description": "Permission name: screen capture (GhostScan)"
  },
  "helpPermScreenCaptureDesc": "Used by GhostScan and the Scan bubble to read a code shown on your screen. Android asks you every time. The app takes one picture of the screen, reads the code on your phone, then throws the picture away. It never records video and never sends the picture anywhere.",
  "@helpPermScreenCaptureDesc": {
    "description": "What the screen capture permission is used for, in plain words"
  },
  "labelPermInternet": "Internet",
  "@labelPermInternet": {
    "description": "Permission name: internet"
  },
  "helpPermInternetDesc": "Scanning works fully offline. The internet is used only by the two optional link checks below. Both are off until you turn them on. While they are off, nothing you scan leaves your phone. Opening a link is done by your browser, not by this app.",
  "@helpPermInternetDesc": {
    "description": "What the internet permission is used for, in plain words"
  },
  "labelPermProbing": "Online link check",
  "@labelPermProbing": {
    "description": "Name of the optional Active Online Probing check on the Permissions screen"
  },
  "helpPermProbingDesc": "Off unless you turn on Active Online Probing in Settings > Privacy & probing. When on, the app visits the scanned link before you open it, to follow its redirects, check its security certificate and see how old the website is.",
  "@helpPermProbingDesc": {
    "description": "What Active Online Probing does with the internet, in plain words"
  },
  "labelPermLinkServices": "Link safety services",
  "@labelPermLinkServices": {
    "description": "Name of the optional online link safety services on the Permissions screen"
  },
  "helpPermLinkServicesDesc": "Off unless you turn them on in Settings > URL Safety Providers. When on, the scanned link is sent to the services you chose (such as Google Safe Browsing or VirusTotal) to check it against their lists of harmful sites. Some need your own API key, which is kept in the phone's secure storage.",
  "@helpPermLinkServicesDesc": {
    "description": "What the optional online link safety services do with the internet, in plain words"
  },
  "labelPermWifi": "Wi-Fi connect",
  "@labelPermWifi": {
    "description": "Permission name: Wi-Fi and network control"
  },
  "helpPermWifiDesc": "Used only when you tap Connect to Wi-Fi on a scanned Wi-Fi QR code, to add that network to your phone. On newer Android versions, Android asks you to confirm first. The app does not read your saved Wi-Fi passwords.",
  "@helpPermWifiDesc": {
    "description": "What the Wi-Fi and network permissions are used for, in plain words"
  },
  "labelPermBackground": "Keep running",
  "@labelPermBackground": {
    "description": "Permission name: keep running in the background (foreground services)"
  },
  "helpPermBackgroundDesc": "Lets GhostScan and the Scan bubble keep working while you are in another app. Android always shows a notification while this is running, so you know about it.",
  "@helpPermBackgroundDesc": {
    "description": "What the foreground service permissions are used for, in plain words"
  },
  "labelPermBoot": "Start after restart",
  "@labelPermBoot": {
    "description": "Permission name: start after phone restart"
  },
  "helpPermBootDesc": "Brings the Scan bubble back after your phone restarts, but only if the bubble was on and you turned on Start after restart. Otherwise it does nothing.",
  "@helpPermBootDesc": {
    "description": "What the start-after-restart permission is used for, in plain words"
  },
  "labelPermStorage": "Photos and files",
  "@labelPermStorage": {
    "description": "Name of the storage permission, which the app does not ask for"
  },
  "helpPermStorageDesc": "The app has no storage permission. When you scan from a picture or a PDF, Android's own picker opens, and the app gets only the file you choose.",
  "@helpPermStorageDesc": {
    "description": "Explains that the app has no storage permission and uses the system picker"
  },
  "labelPermMicrophone": "Microphone",
  "@labelPermMicrophone": {
    "description": "Name of the microphone permission, which the app does not ask for"
  },
  "helpPermMicrophoneDesc": "The app does not use the microphone. The camera always opens with sound turned off.",
  "@helpPermMicrophoneDesc": {
    "description": "Explains that the app does not use the microphone"
  },
  "labelPermVibration": "Vibration",
