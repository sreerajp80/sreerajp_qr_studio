  "helpGuideSafeBrowsingSummary": "Acquiring a Google Cloud API key, hardware keystore storage, and lookup quotas.",
  "@helpGuideSafeBrowsingSummary": {
    "description": "Help Center hub: card subtitle for the Google Safe Browsing setup guide"
  },
  "helpGuideSafeBrowsingIntro": "Google Safe Browsing enables Layer 6 cloud threat intelligence to check scanned URLs against billions of constantly updated known malware, social engineering, and phishing threat entries.",
  "@helpGuideSafeBrowsingIntro": {
    "description": "Safe Browsing help screen: intro paragraph"
  },
  "helpGuideSafeBrowsingKeyTitle": "How to Obtain a Free API Key",
  "@helpGuideSafeBrowsingKeyTitle": {
    "description": "Safe Browsing help screen: section heading for the API key steps"
  },
  "helpGuideSafeBrowsingKeyStep1": "1. Open the Google Cloud Console (console.cloud.google.com) on your computer or mobile browser.",
  "@helpGuideSafeBrowsingKeyStep1": {
    "description": "Safe Browsing help screen: API key step 1 (keep the URL as-is)"
  },
  "helpGuideSafeBrowsingKeyStep2": "2. Create a new Google Cloud Project (e.g., \"My QR Reader Security\").",
  "@helpGuideSafeBrowsingKeyStep2": {
    "description": "Safe Browsing help screen: API key step 2 (the quoted project name is an English example)"
  },
  "helpGuideSafeBrowsingKeyStep3": "3. Navigate to APIs & Services -> Library and search for \"Web Risk API\" or \"Safe Browsing API\" and click Enable.",
  "@helpGuideSafeBrowsingKeyStep3": {
    "description": "Safe Browsing help screen: API key step 3. Google Cloud Console menu names stay in English."
  },
  "helpGuideSafeBrowsingKeyStep4": "4. Go to APIs & Services -> Credentials and click \"+ CREATE CREDENTIALS\" -> \"API key\".",
  "@helpGuideSafeBrowsingKeyStep4": {
    "description": "Safe Browsing help screen: API key step 4. Google Cloud Console menu names stay in English."
  },
  "helpGuideSafeBrowsingKeyStep5": "5. Copy your new API key and paste it into the Google Safe Browsing field under Settings.",
  "@helpGuideSafeBrowsingKeyStep5": {
    "description": "Safe Browsing help screen: API key step 5"
  },
  "helpGuideSafeBrowsingPrivacyTitle": "Privacy & Secure Keystore Storage",
  "@helpGuideSafeBrowsingPrivacyTitle": {
    "description": "Safe Browsing help screen: section heading about key storage and privacy"
  },
  "helpGuideSafeBrowsingPrivacyBullet1": "Your API key is encrypted using Android Keystore hardware-backed secure storage (FlutterSecureStorage) and never exported or shared.",
  "@helpGuideSafeBrowsingPrivacyBullet1": {
    "description": "Safe Browsing help screen: privacy bullet 1"
  },
  "helpGuideSafeBrowsingPrivacyBullet2": "Google Safe Browsing is 100% optional. If no key is provided, the app continues to perform comprehensive offline checks.",
  "@helpGuideSafeBrowsingPrivacyBullet2": {
    "description": "Safe Browsing help screen: privacy bullet 2"
  },
  "helpGuideSafeBrowsingPrivacyBullet3": "Free Tier Quota: Google provides up to 10,000 free requests per day, and the app resets its local usage counter every 24 hours.",
  "@helpGuideSafeBrowsingPrivacyBullet3": {
    "description": "Safe Browsing help screen: privacy bullet 3 (daily free quota)"
  },
  "helpGuideSafeBrowsingTip": "Tip: Safe Browsing checks only execute after offline heuristics pass, conserving your daily lookup quota.",
  "@helpGuideSafeBrowsingTip": {
    "description": "Safe Browsing help screen: tip box at the bottom"
  },
