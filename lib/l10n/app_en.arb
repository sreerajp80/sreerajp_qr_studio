  "helpGuideBarcodeSummary": "Scan with the camera, or from photos, PDF files and copied text. Scan many codes in a row.",
  "@helpGuideBarcodeSummary": {
    "description": "Help hub card summary for the scanning guide"
  },
  "helpGuideBarcodeIntro": "Point your camera at a code and the app reads it at once. You can also read codes from photos, PDF files and copied text. All reading happens on your phone, with no internet needed.",
  "@helpGuideBarcodeIntro": {
    "description": "Opening paragraph of the scanning guide"
  },
  "helpGuideBarcodeCameraTitle": "Scan with the camera",
  "@helpGuideBarcodeCameraTitle": {
    "description": "Scanning guide section heading: scanning with the camera"
  },
  "helpGuideBarcodeCameraBullet1": "Open the Scan tab and hold the code inside the frame. The app reads it by itself. You do not need to tap anything.",
  "@helpGuideBarcodeCameraBullet1": {
    "description": "Scanning guide: how to scan with the camera"
  },
  "helpGuideBarcodeCameraBullet2": "It reads QR codes (also the small Micro QR and rMQR kinds), Data Matrix, Aztec, PDF417 and MaxiCode. It also reads shop and parcel barcodes such as EAN, UPC, Code 128, Code 39, Code 93, Codabar, ITF and DataBar.",
  "@helpGuideBarcodeCameraBullet2": {
    "description": "Scanning guide: list of code types the app can read"
  },
  "helpGuideBarcodeCameraBullet3": "Flash: tap the flash button to switch between Off, On and Auto. In Auto, the flash comes on by itself when it is dark.",
  "@helpGuideBarcodeCameraBullet3": {
    "description": "Scanning guide: the flash button and its three modes"
  },
  "helpGuideBarcodeCameraBullet4": "Zoom: use the zoom slider for small or far-away codes. This works better than moving the phone very close.",
  "@helpGuideBarcodeCameraBullet4": {
    "description": "Scanning guide: the zoom slider"
  },
  "helpGuideBarcodeCameraBullet5": "Switch camera: change between the back and the front camera.",
  "@helpGuideBarcodeCameraBullet5": {
    "description": "Scanning guide: the switch camera button"
  },
  "helpGuideBarcodeCameraBullet6": "Pause: tap Pause scanning to stop for a moment, and Resume scanning to start again.",
  "@helpGuideBarcodeCameraBullet6": {
    "description": "Scanning guide: pausing and resuming the scanner"
  },
  "helpGuideBarcodeGalleryTitle": "Scan a photo or screenshot",
  "@helpGuideBarcodeGalleryTitle": {
    "description": "Scanning guide section heading: scanning a photo"
  },
  "helpGuideBarcodeGalleryBullet1": "Tap the gallery button at the top of the Scan screen and pick a photo or screenshot.",
  "@helpGuideBarcodeGalleryBullet1": {
    "description": "Scanning guide: how to scan a photo from the gallery"
  },
  "helpGuideBarcodeGalleryBullet2": "Android's own picker opens. The app sees only the one picture you choose.",
  "@helpGuideBarcodeGalleryBullet2": {
    "description": "Scanning guide: the photo picker sees only the chosen picture"
  },
  "helpGuideBarcodeGalleryBullet3": "If the picture has more than one code, the app finds them all.",
  "@helpGuideBarcodeGalleryBullet3": {
    "description": "Scanning guide: a photo can contain several codes"
  },
  "helpGuideBarcodePdfTitle": "Scan a PDF file",
  "@helpGuideBarcodePdfTitle": {
    "description": "Scanning guide section heading: scanning a PDF file"
  },
  "helpGuideBarcodePdfBullet1": "Tap the PDF button and choose a file, such as a ticket, bill or boarding pass.",
  "@helpGuideBarcodePdfBullet1": {
    "description": "Scanning guide: how to pick a PDF file"
  },
  "helpGuideBarcodePdfBullet2": "The app checks every page and lists each code it finds, with its page number.",
  "@helpGuideBarcodePdfBullet2": {
    "description": "Scanning guide: every page of the PDF is checked"
  },
  "helpGuideBarcodePdfBullet3": "Tap Save all to keep them all in your history at once.",
  "@helpGuideBarcodePdfBullet3": {
    "description": "Scanning guide: saving all PDF codes to history"
  },
  "helpGuideBarcodePdfBullet4": "You can also share a PDF to this app from another app, such as your email or files app.",
  "@helpGuideBarcodePdfBullet4": {
    "description": "Scanning guide: a PDF can be shared to the app from another app"
  },
  "helpGuideBarcodeClipboardTitle": "Scan copied text or pictures",
  "@helpGuideBarcodeClipboardTitle": {
    "description": "Scanning guide section heading: scanning copied text or pictures"
  },
  "helpGuideBarcodeClipboardBullet1": "If you copied a link, a code's text or a picture, tap the clipboard button at the top of the Scan screen to check it.",
  "@helpGuideBarcodeClipboardBullet1": {
    "description": "Scanning guide: the clipboard button"
  },
  "helpGuideBarcodeClipboardBullet2": "When you come back to the app with something copied, a small bar may offer to check it. Tap Scan Now, or close the bar.",
  "@helpGuideBarcodeClipboardBullet2": {
    "description": "Scanning guide: the clipboard bar that appears when the app opens"
  },
  "helpGuideBarcodeClipboardBullet3": "Copied links get the same safety check as scanned links.",
  "@helpGuideBarcodeClipboardBullet3": {
    "description": "Scanning guide: copied links get the same safety check"
  },
  "helpGuideBarcodeBatchTitle": "Scan many codes in a row",
  "@helpGuideBarcodeBatchTitle": {
    "description": "Scanning guide section heading: batch scan mode"
  },
  "helpGuideBarcodeBatchBullet1": "Tap the batch button to turn on batch mode. The camera keeps scanning, and each new code is added to a list.",
  "@helpGuideBarcodeBatchBullet1": {
    "description": "Scanning guide: turning on batch mode"
  },
  "helpGuideBarcodeBatchBullet2": "A counter shows how many codes you have scanned. Tap it to open the list.",
  "@helpGuideBarcodeBatchBullet2": {
    "description": "Scanning guide: the batch counter opens the list"
  },
  "helpGuideBarcodeBatchBullet3": "In the list you can look at each code, turn on Prevent Duplicates, and export the list as CSV, JSON, text or PDF.",
  "@helpGuideBarcodeBatchBullet3": {
    "description": "Scanning guide: what you can do in the batch list"
  },
  "helpGuideBarcodeBatchBullet4": "Tap the batch button again to go back to normal scanning.",
  "@helpGuideBarcodeBatchBullet4": {
    "description": "Scanning guide: turning off batch mode"
  },
  "helpGuideBarcodeTuneTitle": "When a code is hard to read",
  "@helpGuideBarcodeTuneTitle": {
    "description": "Scanning guide section heading: the camera adjustments sheet"
  },
  "helpGuideBarcodeTuneBullet1": "Tap the Camera adjustments button. Your changes show on the camera picture at once.",
  "@helpGuideBarcodeTuneBullet1": {
    "description": "Scanning guide: opening camera adjustments"
  },
  "helpGuideBarcodeTuneBullet2": "Brightness and Contrast: make a dark or faded code clearer.",
  "@helpGuideBarcodeTuneBullet2": {
    "description": "Scanning guide: the brightness and contrast sliders"
  },
  "helpGuideBarcodeTuneBullet3": "Invert colors: for a light code on a dark background, such as on a dark screen or on metal.",
  "@helpGuideBarcodeTuneBullet3": {
    "description": "Scanning guide: the invert colors switch"
  },
  "helpGuideBarcodeTuneBullet4": "Camera Resolution: 1080p suits most phones. 720p saves battery. Maximum helps with very small codes.",
  "@helpGuideBarcodeTuneBullet4": {
    "description": "Scanning guide: the camera resolution choices"
  },
  "helpGuideBarcodeTuneBullet5": "Distance Scan Assist: helps read codes far away, such as on posters and signs. Fine-tune it with Distance Zoom and Edge Sharpness.",
  "@helpGuideBarcodeTuneBullet5": {
    "description": "Scanning guide: Distance Scan Assist and its sliders"
  },
  "helpGuideBarcodeTuneBullet6": "Multi-Code Selection: when more than one code is in view, each one gets an outline. Tap the one you want.",
  "@helpGuideBarcodeTuneBullet6": {
    "description": "Scanning guide: Multi-Code Selection"
  },
  "helpGuideBarcodeTuneBullet7": "Reset Adjustments puts everything back to normal.",
  "@helpGuideBarcodeTuneBullet7": {
    "description": "Scanning guide: the reset adjustments button"
  },
  "helpGuideBarcodeTip": "Tip: Codes are read on your phone. Camera pictures are never saved or sent anywhere.",
  "@helpGuideBarcodeTip": {
    "description": "Tip at the end of the scanning guide"
  },
  "helpGuideArCodeVisionName": "AR CodeVision",
