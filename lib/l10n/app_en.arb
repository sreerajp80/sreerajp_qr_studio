  "helpGuideQuishingCvTitle": "On-Device Computer Vision Analysis",
  "@helpGuideQuishingCvTitle": {
    "description": "QuishingGuard help screen: section heading about on-device computer vision"
  },
  "helpGuideQuishingCvBullet1": "Edge Discontinuity Metric: Detects double edges, cutting misalignment, and micro-shadows along the boundary of pasted overlay stickers.",
  "@helpGuideQuishingCvBullet1": {
    "description": "QuishingGuard help screen: computer vision bullet 1 (edge metric)"
  },
  "helpGuideQuishingCvBullet2": "Print Grain & Halftone Metric: Identifies inconsistencies in dot pitch, chromatic noise, and print resolution between the code and surrounding background poster.",
  "@helpGuideQuishingCvBullet2": {
    "description": "QuishingGuard help screen: computer vision bullet 2 (print grain metric)"
  },
  "helpGuideQuishingCvBullet3": "Calculates a combined Tamper Risk Score from 0% (Authentic) to 100% (High Tamper Risk).",
  "@helpGuideQuishingCvBullet3": {
    "description": "QuishingGuard help screen: computer vision bullet 3 (risk score)"
  },
  "helpGuideQuishingForensicTitle": "Forensic Signal Inspection",
  "@helpGuideQuishingForensicTitle": {
    "description": "QuishingGuard help screen: section heading about forensic signals"
  },
  "helpGuideQuishingForensicBullet1": "Tap \"View Forensic Analysis\" on any scanned code to view real-time CV confidence levels, border edge metrics, and chromatic noise charts.",
  "@helpGuideQuishingForensicBullet1": {
    "description": "QuishingGuard help screen: forensic bullet 1. The quoted text must match the quishingViewSignals button."
  },
  "helpGuideQuishingForensicBullet2": "Helps identify suspicious payment QR codes in public places before sending money or typing credentials.",
  "@helpGuideQuishingForensicBullet2": {
    "description": "QuishingGuard help screen: forensic bullet 2"
  },
  "helpGuideQuishingTip": "Tip: When scanning outdoor QR codes on parking meters or public kiosks, inspect the code physically with your fingers if QuishingGuard flags an edge discontinuity alert.",
  "@helpGuideQuishingTip": {
