  "helpGuideUrlSafetyLayersTitle": "The 6 Safety Layers Explained",
  "@helpGuideUrlSafetyLayersTitle": {
    "description": "URL safety help screen: section heading for the list of 6 layers"
  },
  "helpGuideUrlSafetyLayersBullet1": "Layer 1: Protocol & Scheme Guard - Enforces HTTPS encryption and verifies standard protocol formatting while intercepting malformed or zero-width character traps.",
  "@helpGuideUrlSafetyLayersBullet1": {
    "description": "URL safety help screen: layer 1 description"
  },
  "helpGuideUrlSafetyLayersBullet2": "Layer 2: Homograph & Unicode Attack Shield - Identifies Cyrillic, Greek, and mixed-script lookalike characters (such as \"а\" instead of \"a\") used by scammers to imitate trusted websites.",
  "@helpGuideUrlSafetyLayersBullet2": {
    "description": "URL safety help screen: layer 2 description. Keep the Cyrillic example letter as-is."
  },
  "helpGuideUrlSafetyLayersBullet3": "Layer 3: Suspicious TLD & Entropy Analysis - Flags high-risk domain endings (.xyz, .top, .work), excessive subdomain nesting, and randomized machine-generated domain names.",
  "@helpGuideUrlSafetyLayersBullet3": {
    "description": "URL safety help screen: layer 3 description"
  },
  "helpGuideUrlSafetyLayersBullet4": "Layer 4: Heuristic IP & Non-Standard Port Trap - Detects links connecting directly to numeric IP addresses or weird port numbers often used by botnet malware servers.",
  "@helpGuideUrlSafetyLayersBullet4": {
    "description": "URL safety help screen: layer 4 description"
  },
  "helpGuideUrlSafetyLayersBullet5": "Layer 5: Privacy-Safe Online Head Probing - Optionally follows shortened URL redirects (bit.ly, tinyurl) and inspects SSL certificate trust chains without executing malicious JavaScript.",
  "@helpGuideUrlSafetyLayersBullet5": {
    "description": "URL safety help screen: layer 5 description"
  },
  "helpGuideUrlSafetyLayersBullet6": "Layer 6: Google Safe Browsing API Integration - Optional cloud-based real-time threat intelligence protecting against phishing sites and malware distribution networks.",
  "@helpGuideUrlSafetyLayersBullet6": {
    "description": "URL safety help screen: layer 6 description"
  },
  "helpGuideUrlSafetyVerdictsTitle": "Safety Verdicts & Action Guidance",
