  "helpGuideArCodeVisionOpenTitle": "How to open it",
  "@helpGuideArCodeVisionOpenTitle": {
    "description": "AR CodeVision guide section heading: how to open it"
  },
  "helpGuideArCodeVisionOpenBullet1": "On the Scan screen, tap More options (the three dots) and choose AR CodeVision HUD.",
  "@helpGuideArCodeVisionOpenBullet1": {
    "description": "AR CodeVision guide: where to find it in the menu"
  },
  "helpGuideArCodeVisionOpenBullet2": "Allow the camera if Android asks.",
  "@helpGuideArCodeVisionOpenBullet2": {
    "description": "AR CodeVision guide: allowing the camera"
  },
  "helpGuideArCodeVisionTrackingTitle": "The two modes",
  "@helpGuideArCodeVisionTrackingTitle": {
    "description": "AR CodeVision guide section heading: the two modes"
  },
  "helpGuideArCodeVisionTrackingBullet1": "Safety: each link gets a colour badge. Green means no problems were found. Red means the link looks unsafe.",
  "@helpGuideArCodeVisionTrackingBullet1": {
    "description": "AR CodeVision guide: the Safety mode and its colour badges"
