  "helpGuideScanBubbleGhostTitle": "GhostScan: scan the screen once",
  "@helpGuideScanBubbleGhostTitle": {
    "description": "Section heading: GhostScan, which scans the screen once"
  },
  "helpGuideScanBubbleGhostBullet1": "On the Scan screen, tap More options and choose GhostScan.",
  "@helpGuideScanBubbleGhostBullet1": {
    "description": "GhostScan: where to find it"
  },
  "helpGuideScanBubbleGhostBullet2": "Tap Add Settings tile to put a GhostScan button in your Quick Settings (the panel you pull down from the top of the screen).",
